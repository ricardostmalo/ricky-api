{
  "name": "getricky",
  "version": "0.1.14",
  "description": "Official TypeScript SDK for the Ricky REST API",
  "keywords": [
    "api",
    "conversations",
    "crm",
    "instagram",
    "messenger",
    "ricky",
    "sdk",
    "whatsapp"
  ],
  "homepage": "https://getricky.ai/docs/api",
  "bugs": {
    "url": "https://github.com/ricardostmalo/ricky-api/issues",
    "email": "ricardo@getricky.ai"
  },
  "license": "MIT",
  "author": "Ricky <ricardo@getricky.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardostmalo/ricky-api.git",
    "directory": "sdks/typescript"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "npm run build && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.spec.ts",
    "prepublishOnly": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
